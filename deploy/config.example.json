{
  "projectName": "libresign-custom",
  "publicUrl": "https://localhost:18443",
  "publishHttp": false,
  "httpBind": "127.0.0.1",
  "httpPort": 18085,
  "httpsBind": "127.0.0.1",
  "httpsPort": 18443,
  "mailpitPort": 18025,
  "adminUser": "admin",
  "integration": {
    "uid": "provider-client",
    "policy": {
      "enabled": true,
      "scopes": ["certificates:read", "certificates:write", "certificates:revoke", "signing:read", "signing:write"],
      "otpChannel": "email",
      "mockOtpEnabled": false,
      "trustedSources": ["provider-client"]
    }
  },
  "smtp": null,
  "ca": {
    "commonName": "LibreSign Development CA",
    "organization": "LibreSign Development",
    "country": "VN"
  }
}
